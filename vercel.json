{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "python3 -m pip install -r requirements-docs.txt",
  "buildCommand": "python3 -m zensical build --strict",
  "outputDirectory": "site",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/demo",
      "destination": "https://geospax.fly.dev/",
      "permanent": false
    },
    {
      "source": "/demo/:path*",
      "destination": "https://geospax.fly.dev/:path*",
      "permanent": false
    }
  ]
}

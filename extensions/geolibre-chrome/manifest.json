{
  "manifest_version": 3,
  "name": "Open data in GeoSpaX",
  "description": "Find geospatial datasets and services used by the current page and open them in GeoSpaX.",
  "version": "0.3.1",
  "homepage_url": "https://jm0535.github.io/GeoSpaX/",
  "minimum_chrome_version": "106",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Open data in GeoSpaX",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/geospax-16.png",
      "32": "icons/geospax-32.png"
    }
  },
  "icons": {
    "16": "icons/geospax-16.png",
    "32": "icons/geospax-32.png",
    "48": "icons/geospax-48.png",
    "128": "icons/geospax-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
